@baseUrl = http://localhost:3000
@password = fake-password-123

# =====================================================================
# PART A: register, login, token
# =====================================================================

### A1 Register the OWNER
# Expected: 201 and a user WITHOUT a password field. (409 if you already ran it)
POST {{baseUrl}}/users
Content-Type: application/json

{
  "email": "owner1@example.com",
  "name": "Olga Owner",
  "password": "{{password}}"
}

### A2 Register the MEMBER
# Expected: 201 (409 if already registered)
POST {{baseUrl}}/users
Content-Type: application/json

{
  "email": "member1@example.com",
  "name": "Mark Member",
  "password": "{{password}}"
}

### A3 Register the OUTSIDER
# Expected: 201 (409 if already registered)
POST {{baseUrl}}/users
Content-Type: application/json

{
  "email": "outsider1@example.com",
  "name": "Oscar Outsider",
  "password": "{{password}}"
}

### A4 Duplicate email
# Expected: 409 (the email already exists)
POST {{baseUrl}}/users
Content-Type: application/json

{
  "email": "owner1@example.com",
  "name": "Olga Again",
  "password": "{{password}}"
}

### A5 Invalid email
# Expected: 400 (message says the email must be an email)
POST {{baseUrl}}/users
Content-Type: application/json

{
  "email": "not-an-email",
  "name": "Test",
  "password": "{{password}}"
}

### A6 Password too short
# Expected: 400 (password must be at least 8 characters)
POST {{baseUrl}}/users
Content-Type: application/json

{
  "email": "short1@example.com",
  "name": "Test",
  "password": "abc"
}

### A7 Extra field that must be ignored
# Expected: 201 and the response has NO "isAdmin" field. (409 if you ran it before)
POST {{baseUrl}}/users
Content-Type: application/json

{
  "email": "extra1@example.com",
  "name": "Extra",
  "password": "{{password}}",
  "isAdmin": true
}

### A8 Login OWNER
# Expected: 200 or 201 with an accessToken
# @name loginOwner
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "owner1@example.com",
  "password": "{{password}}"
}

### A9 Login MEMBER
# Expected: 200 or 201 with an accessToken
# @name loginMember
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "member1@example.com",
  "password": "{{password}}"
}

### A10 Login OUTSIDER
# Expected: 200 or 201 with an accessToken
# @name loginOutsider
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "outsider1@example.com",
  "password": "{{password}}"
}

### A11 Wrong password
# Expected: 401
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "owner1@example.com",
  "password": "wrong-password-999"
}

### A12 Unknown email
# Expected: 401 (the SAME answer as A11, so nobody can learn which emails exist)
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "nobody1@example.com",
  "password": "{{password}}"
}

### A13 Who am I (with the owner token)
# Expected: 200 and the owner data, without a password
GET {{baseUrl}}/auth/me
Authorization: Bearer {{loginOwner.response.body.accessToken}}

### A14 Who am I (without a token)
# Expected: 401
GET {{baseUrl}}/auth/me

### A15 Who am I (with a garbage token)
# Expected: 401
GET {{baseUrl}}/auth/me
Authorization: Bearer not-a-real-token

# =====================================================================
# PART B: projects and members
# =====================================================================

### B1 OWNER creates the main project
# Expected: 201 with id, name, ownerId
# @name createProject
POST {{baseUrl}}/projects
Authorization: Bearer {{loginOwner.response.body.accessToken}}
Content-Type: application/json

{
  "name": "Final test project",
  "description": "Created by the final test"
}

### B2 MEMBER lists projects (not added yet)
# Expected: 200 and the list does NOT contain the project from B1
GET {{baseUrl}}/projects
Authorization: Bearer {{loginMember.response.body.accessToken}}

### B3 OUTSIDER reads the project
# Expected: 404 (outsiders must not learn that the project exists)
GET {{baseUrl}}/projects/{{createProject.response.body.id}}
Authorization: Bearer {{loginOutsider.response.body.accessToken}}

### B4 OWNER adds the MEMBER
# Expected: 201 with role MEMBER and the user (id, email, name)
# Also check the SERVER terminal: two [InvitationProcessor] lines, about 2 seconds apart
# @name addMember
POST {{baseUrl}}/projects/{{createProject.response.body.id}}/members
Authorization: Bearer {{loginOwner.response.body.accessToken}}
Content-Type: application/json

{
  "email": "member1@example.com"
}

### B5 Add the same member again
# Expected: 409
POST {{baseUrl}}/projects/{{createProject.response.body.id}}/members
Authorization: Bearer {{loginOwner.response.body.accessToken}}
Content-Type: application/json

{
  "email": "member1@example.com"
}

### B6 Add a user that does not exist
# Expected: 404
POST {{baseUrl}}/projects/{{createProject.response.body.id}}/members
Authorization: Bearer {{loginOwner.response.body.accessToken}}
Content-Type: application/json

{
  "email": "nobody1@example.com"
}

### B7 OUTSIDER tries to add someone
# Expected: 404 (not a member, so the project "does not exist" for them)
POST {{baseUrl}}/projects/{{createProject.response.body.id}}/members
Authorization: Bearer {{loginOutsider.response.body.accessToken}}
Content-Type: application/json

{
  "email": "outsider1@example.com"
}

### B8 MEMBER tries to add someone
# Expected: 403 (a member, but not the owner)
POST {{baseUrl}}/projects/{{createProject.response.body.id}}/members
Authorization: Bearer {{loginMember.response.body.accessToken}}
Content-Type: application/json

{
  "email": "outsider1@example.com"
}

### B9 MEMBER lists the members
# Expected: 200 and exactly two members: one OWNER and one MEMBER
GET {{baseUrl}}/projects/{{createProject.response.body.id}}/members
Authorization: Bearer {{loginMember.response.body.accessToken}}

### B10 MEMBER reads the project
# Expected: 200 (now the member can see it)
GET {{baseUrl}}/projects/{{createProject.response.body.id}}
Authorization: Bearer {{loginMember.response.body.accessToken}}

### B11 MEMBER renames the project (EXPLORATORY)
# We do not know the answer yet. Write down what you get and tell me.
PATCH {{baseUrl}}/projects/{{createProject.response.body.id}}
Authorization: Bearer {{loginMember.response.body.accessToken}}
Content-Type: application/json

{
  "name": "Renamed by the member"
}

### B12 MEMBER deletes the project
# Expected: 403
DELETE {{baseUrl}}/projects/{{createProject.response.body.id}}
Authorization: Bearer {{loginMember.response.body.accessToken}}

### B13 OUTSIDER deletes the project
# Expected: 404
DELETE {{baseUrl}}/projects/{{createProject.response.body.id}}
Authorization: Bearer {{loginOutsider.response.body.accessToken}}

### B14 OWNER renames the project to an empty name
# Expected: 400 (validation: the name cannot be empty)
PATCH {{baseUrl}}/projects/{{createProject.response.body.id}}
Authorization: Bearer {{loginOwner.response.body.accessToken}}
Content-Type: application/json

{
  "name": ""
}

### B15 The id is not a number
# Expected: 400 (ParseIntPipe rejects "abc")
GET {{baseUrl}}/projects/abc
Authorization: Bearer {{loginOwner.response.body.accessToken}}

### B16 A project that does not exist
# Expected: 404
GET {{baseUrl}}/projects/999999
Authorization: Bearer {{loginOwner.response.body.accessToken}}

### B17 OWNER creates a TEMP project (for the removal tests)
# Expected: 201
# @name createTemp
POST {{baseUrl}}/projects
Authorization: Bearer {{loginOwner.response.body.accessToken}}
Content-Type: application/json

{
  "name": "Temp project",
  "description": "Will be deleted"
}

### B18 OWNER adds the MEMBER to the temp project
# Expected: 201
# @name addMemberTemp
POST {{baseUrl}}/projects/{{createTemp.response.body.id}}/members
Authorization: Bearer {{loginOwner.response.body.accessToken}}
Content-Type: application/json

{
  "email": "member1@example.com"
}

### B19 OWNER tries to remove the OWNER
# Expected: 400 (the owner cannot be removed)
DELETE {{baseUrl}}/projects/{{createTemp.response.body.id}}/members/{{createTemp.response.body.ownerId}}
Authorization: Bearer {{loginOwner.response.body.accessToken}}

### B20 OWNER removes the MEMBER
# Expected: 204 (no body)
DELETE {{baseUrl}}/projects/{{createTemp.response.body.id}}/members/{{addMemberTemp.response.body.user.id}}
Authorization: Bearer {{loginOwner.response.body.accessToken}}

### B21 Remove the same member again
# Expected: 404 (Member not found)
DELETE {{baseUrl}}/projects/{{createTemp.response.body.id}}/members/{{addMemberTemp.response.body.user.id}}
Authorization: Bearer {{loginOwner.response.body.accessToken}}

### B22 The removed MEMBER reads the temp project
# Expected: 404 (access is gone)
GET {{baseUrl}}/projects/{{createTemp.response.body.id}}
Authorization: Bearer {{loginMember.response.body.accessToken}}

### B23 OWNER deletes the temp project
# Expected: 204
DELETE {{baseUrl}}/projects/{{createTemp.response.body.id}}
Authorization: Bearer {{loginOwner.response.body.accessToken}}

### B24 Read the deleted temp project
# Expected: 404
GET {{baseUrl}}/projects/{{createTemp.response.body.id}}
Authorization: Bearer {{loginOwner.response.body.accessToken}}

# =====================================================================
# PART C: tasks (they live in the main project from B1)
# The OWNER and the MEMBER are both members of that project now.
# =====================================================================

### C1 OWNER creates task 1
# Expected: 201 with id, title, projectId (status should be TODO)
# @name createTask1
POST {{baseUrl}}/tasks
Authorization: Bearer {{loginOwner.response.body.accessToken}}
Content-Type: application/json

{
  "title": "Buy paint",
  "description": "Two cans of white paint",
  "projectId": {{createProject.response.body.id}}
}

### C2 OWNER creates task 2
# Expected: 201
# @name createTask2
POST {{baseUrl}}/tasks
Authorization: Bearer {{loginOwner.response.body.accessToken}}
Content-Type: application/json

{
  "title": "Paint the wall",
  "projectId": {{createProject.response.body.id}}
}

### C3 MEMBER creates task 3
# Expected: 201 (we expect members to be allowed to add tasks; tell me if not)
# @name createTask3
POST {{baseUrl}}/tasks
Authorization: Bearer {{loginMember.response.body.accessToken}}
Content-Type: application/json

{
  "title": "Move the furniture",
  "projectId": {{createProject.response.body.id}}
}

### C4 OUTSIDER creates a task in the project
# Expected: 404
POST {{baseUrl}}/tasks
Authorization: Bearer {{loginOutsider.response.body.accessToken}}
Content-Type: application/json

{
  "title": "Sneaky task",
  "projectId": {{createProject.response.body.id}}
}

### C5 Empty title
# Expected: 400
POST {{baseUrl}}/tasks
Authorization: Bearer {{loginOwner.response.body.accessToken}}
Content-Type: application/json

{
  "title": "",
  "projectId": {{createProject.response.body.id}}
}

### C6 Missing projectId
# Expected: 400
POST {{baseUrl}}/tasks
Authorization: Bearer {{loginOwner.response.body.accessToken}}
Content-Type: application/json

{
  "title": "No project"
}

### C7 A project that does not exist
# Expected: 404
POST {{baseUrl}}/tasks
Authorization: Bearer {{loginOwner.response.body.accessToken}}
Content-Type: application/json

{
  "title": "Lost task",
  "projectId": 999999
}

### C8 OWNER lists the tasks (first time: cache MISS)
# Expected: 200 with { data: [...], meta: {...} } and 3 tasks
# Then run in the terminal: docker exec taskmanager-redis redis-cli keys "tasks:*"
# You should see at least one key (the cache was filled).
GET {{baseUrl}}/tasks?projectId={{createProject.response.body.id}}
Authorization: Bearer {{loginOwner.response.body.accessToken}}

### C9 OWNER lists the tasks again (cache HIT)
# Expected: 200 and exactly the same data as C8 (but served from Redis)
GET {{baseUrl}}/tasks?projectId={{createProject.response.body.id}}
Authorization: Bearer {{loginOwner.response.body.accessToken}}

### C10 OUTSIDER lists the tasks
# Expected: 404 (the membership check runs BEFORE the cache, so the cached data stays private)
GET {{baseUrl}}/tasks?projectId={{createProject.response.body.id}}
Authorization: Bearer {{loginOutsider.response.body.accessToken}}

### C11 MEMBER lists the tasks
# Expected: 200 with the same 3 tasks
GET {{baseUrl}}/tasks?projectId={{createProject.response.body.id}}
Authorization: Bearer {{loginMember.response.body.accessToken}}

### C12 Filter by status TODO
# Expected: 200 and only tasks with status TODO
GET {{baseUrl}}/tasks?projectId={{createProject.response.body.id}}&status=TODO
Authorization: Bearer {{loginOwner.response.body.accessToken}}

### C13 Search (upper case on purpose)
# Expected: 200 and exactly 2 tasks: "Buy paint" and "Paint the wall" (search ignores case)
GET {{baseUrl}}/tasks?projectId={{createProject.response.body.id}}&search=PAINT
Authorization: Bearer {{loginOwner.response.body.accessToken}}

### C14 Pagination: page 1 with limit 1
# Expected: 200, data has 1 task, meta shows the total (3) and page 1
GET {{baseUrl}}/tasks?projectId={{createProject.response.body.id}}&page=1&limit=1
Authorization: Bearer {{loginOwner.response.body.accessToken}}

### C15 Pagination: page 2 with limit 1
# Expected: 200, data has 1 DIFFERENT task
GET {{baseUrl}}/tasks?projectId={{createProject.response.body.id}}&page=2&limit=1
Authorization: Bearer {{loginOwner.response.body.accessToken}}

### C16 limit too big
# Expected: 400 (the maximum is 50)
GET {{baseUrl}}/tasks?projectId={{createProject.response.body.id}}&limit=51
Authorization: Bearer {{loginOwner.response.body.accessToken}}

### C17 page is zero
# Expected: 400 (the minimum is 1)
GET {{baseUrl}}/tasks?projectId={{createProject.response.body.id}}&page=0
Authorization: Bearer {{loginOwner.response.body.accessToken}}

### C18 Invalid status
# Expected: 400
GET {{baseUrl}}/tasks?projectId={{createProject.response.body.id}}&status=WRONG
Authorization: Bearer {{loginOwner.response.body.accessToken}}

### C19 Missing projectId in the query
# Expected: 400
GET {{baseUrl}}/tasks
Authorization: Bearer {{loginOwner.response.body.accessToken}}

### C20 OWNER reads task 1
# Expected: 200
GET {{baseUrl}}/tasks/{{createTask1.response.body.id}}
Authorization: Bearer {{loginOwner.response.body.accessToken}}

### C21 OUTSIDER reads task 1
# Expected: 404
GET {{baseUrl}}/tasks/{{createTask1.response.body.id}}
Authorization: Bearer {{loginOutsider.response.body.accessToken}}

### C22 A task that does not exist
# Expected: 404
GET {{baseUrl}}/tasks/999999
Authorization: Bearer {{loginOwner.response.body.accessToken}}

### C23 OWNER moves task 1 to IN_PROGRESS
# Expected: 200 and status IN_PROGRESS. This also clears the cache of the project.
PATCH {{baseUrl}}/tasks/{{createTask1.response.body.id}}
Authorization: Bearer {{loginOwner.response.body.accessToken}}
Content-Type: application/json

{
  "status": "IN_PROGRESS"
}

### C24 Filter by TODO again (proof that the cache was cleared)
# Expected: 200 and task 1 is NOT in the list any more.
# (If the old cached list came back, task 1 would still appear as TODO: that would be a bug.)
GET {{baseUrl}}/tasks?projectId={{createProject.response.body.id}}&status=TODO
Authorization: Bearer {{loginOwner.response.body.accessToken}}

### C25 Update with an invalid status
# Expected: 400
PATCH {{baseUrl}}/tasks/{{createTask1.response.body.id}}
Authorization: Bearer {{loginOwner.response.body.accessToken}}
Content-Type: application/json

{
  "status": "WRONG"
}

### C26 OUTSIDER updates task 1
# Expected: 404
PATCH {{baseUrl}}/tasks/{{createTask1.response.body.id}}
Authorization: Bearer {{loginOutsider.response.body.accessToken}}
Content-Type: application/json

{
  "title": "Hacked title"
}

### C27 MEMBER updates task 1 (EXPLORATORY)
# We do not know the answer yet. Write down what you get and tell me.
PATCH {{baseUrl}}/tasks/{{createTask1.response.body.id}}
Authorization: Bearer {{loginMember.response.body.accessToken}}
Content-Type: application/json

{
  "description": "Edited by the member"
}

### C28 OUTSIDER deletes task 2
# Expected: 404
DELETE {{baseUrl}}/tasks/{{createTask2.response.body.id}}
Authorization: Bearer {{loginOutsider.response.body.accessToken}}

### C29 OWNER deletes task 2
# Expected: 204
DELETE {{baseUrl}}/tasks/{{createTask2.response.body.id}}
Authorization: Bearer {{loginOwner.response.body.accessToken}}

### C30 Read the deleted task 2
# Expected: 404
GET {{baseUrl}}/tasks/{{createTask2.response.body.id}}
Authorization: Bearer {{loginOwner.response.body.accessToken}}

### C31 MEMBER deletes task 3 (EXPLORATORY)
# We do not know the answer yet. Write down what you get and tell me.
DELETE {{baseUrl}}/tasks/{{createTask3.response.body.id}}
Authorization: Bearer {{loginMember.response.body.accessToken}}

### C32 CLEAN UP: OWNER deletes the main project (it still has members and tasks)
# Expected: 204. If you get 500, deleting a project that has members or tasks is broken.
DELETE {{baseUrl}}/projects/{{createProject.response.body.id}}
Authorization: Bearer {{loginOwner.response.body.accessToken}}

### C33 Read the deleted main project
# Expected: 404
GET {{baseUrl}}/projects/{{createProject.response.body.id}}
Authorization: Bearer {{loginOwner.response.body.accessToken}}

### C34 Read task 1 after its project was deleted
# Expected: 404 (the task went away with the project)
GET {{baseUrl}}/tasks/{{createTask1.response.body.id}}
Authorization: Bearer {{loginOwner.response.body.accessToken}}
